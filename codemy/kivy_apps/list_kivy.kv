ScrollView:
    MDList:
        ThreeLineListItem:
            id: item1
            text: "Awesome List Item #1"
            tertiary_text: 'Second Line'
            on_release: app.presser(self, "item1")

        ThreeLineListItem:
            id: item2
            text: "Awesome List Item #2"
            tertiary_text: 'Second Line'
            on_release: app.presser(self, "item2")


        TwoLineListItem:
            id: item1
            text: "Awesome List Item #1"
            secondary_text: 'Second Line'
            on_release: app.presser(self, "item1")

        TwoLineListItem:
            id: item2
            text: "Awesome List Item #2"
            secondary_text: 'Second Line'
            on_release: app.presser(self, "item2")


        OneLineListItem:
            id: item1
            text: "Awesome List Item #1"
            on_release: app.presser(self, "item1")

        OneLineListItem:
            id: item2
            text: "Awesome List Item #2"
            on_release: app.presser(self, "item2")












