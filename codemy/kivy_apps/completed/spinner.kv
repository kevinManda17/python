<MyLayout>
    BoxLayout: 
        orientation: "vertical"
        size: root.width, root.height 

        Label: 
            id : click_label 
            text: "Click Favorite Pizza Below "

        Spinner : 
            id : spinner_id 
            text: "Favorite Pizza"
            values: ["Pepperoni", "Cheese", "MushRoom"]
            on_text: root.spinner_clicked(spinner_id.text) 

        Label: 
            text: "" 