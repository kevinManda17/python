<MyLayout>
    BoxLayout:  
        orientation: "vertical"
        size: root.width, root.height


        Label:
            markup: True
            font_size: 32
            text: "This Is [color=#a12c3c][b]Bold[/b][/color] [font=times]Text[/font] [sup]Up[/sup] and [sub]down[/sub]"
          


        Label:
            markup:True
            font_size: 32
            text: "This Is [size=150][i]Italic[/i][/size] Text"

        Button: 
            markup:True
            font_size:32
            text:"[u]Click[/u] ME!"